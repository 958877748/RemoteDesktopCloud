# 复制为 .env 并填入真实值（.env 已被 gitignore，不会入库）

# Supabase
SUPABASE_URL=https://zdtxqyonglqnyrwayins.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
